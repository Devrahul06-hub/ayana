---
import { projects } from '../data/projects.ts';
---

<section id="work" class="section-pad page-section" style="border-top:1px solid rgba(255,255,255,0.06);">
  <div class="work-header" style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:3.5rem;">
    <div class="fade-up">
      <div style="margin-bottom:1.25rem;">
        <span style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.4rem 1rem;border-radius:9999px;background:linear-gradient(135deg,rgba(34,211,238,0.12) 0%,rgba(129,140,248,0.08) 100%);border:1px solid rgba(34,211,238,0.2);font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:#22D3EE;">
          <span style="width:6px;height:6px;border-radius:50%;background:linear-gradient(135deg,#22D3EE 0%,#818CF8 100%);"></span>
          Portfolio
        </span>
      </div>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,4vw,3.25rem);font-weight:600;line-height:1.12;color:#EDF0FF;letter-spacing:-0.02em;">Featured <em class="gradient-text" style="font-style:normal;">projects</em></h2>
    </div>
    <a href="#contact" style="display:inline-flex;align-items:center;gap:0.5rem;font-family:'IBM Plex Mono',monospace;font-size:0.75rem;font-weight:400;letter-spacing:0.12em;text-transform:uppercase;color:#505A72;text-decoration:none;transition:color 0.2s;" onmouseover="this.style.color='#22D3EE'" onmouseout="this.style.color='#505A72'">
      Start your project
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
    </a>
  </div>

  <div class="work-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;">
    {projects.map((p, i) => (
      <article class={`project-card fade-up delay-${i % 4}`}>
        <div class="card-img-wrap">
          <img src={p.image} alt={p.title} loading="lazy" />
          <div style={`position:absolute;inset:0;background:${p.grad};opacity:0.75;`}></div>
          <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.06) 1px,transparent 1px);background-size:32px 32px;"></div>
          <div style="position:absolute;bottom:16px;left:16px;font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;letter-spacing:0.15em;text-transform:uppercase;color:rgba(255,255,255,0.9);background:rgba(0,0,0,0.5);padding:0.375rem 0.75rem;border-radius:2px;">{p.category}</div>
        </div>
        <div style="padding:1.5rem 1.875rem 2rem;">
          <p style="font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;font-weight:500;letter-spacing:0.15em;text-transform:uppercase;color:#22D3EE;margin-bottom:0.5rem;">{p.category}</p>
          <h3 style="font-family:'Space Grotesk',sans-serif;font-size:1.25rem;font-weight:600;color:#EDF0FF;margin-bottom:0.625rem;">{p.title}</h3>
          <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.8125rem;font-weight:300;color:#8892A8;"><span style="color:#22D3EE;font-weight:500;">Result: </span>{p.result}</p>
        </div>
      </article>
    ))}
  </div>
</section>
