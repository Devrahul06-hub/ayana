---
const items = ['AI Development', '·', 'LLM Integration', '·', 'SaaS Products', '·', 'Mobile Apps', '·', 'Cloud Infra', '·', 'Custom Software', '·'];
const doubled = [...items, ...items];
---

<div style="overflow:hidden;border-top:1px solid rgba(255,255,255,0.06);border-bottom:1px solid rgba(255,255,255,0.06);padding:1rem 0;background:rgba(255,255,255,0.02);">
  <div style="display:flex;gap:2.5rem;animation:marquee 30s linear infinite;font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;font-weight:500;letter-spacing:0.2em;text-transform:uppercase;color:#3D4560;white-space:nowrap;">
    {doubled.map((t, i) => (
      <span style={t === '·' ? 'color:#22D3EE;opacity:0.4;' : ''}>{t}</span>
    ))}
  </div>
</div>
