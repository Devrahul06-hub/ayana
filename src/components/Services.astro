---
import { services } from '../data/services.ts';

const iconPaths: Record<string, string> = {
  'AI Development': 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1 1 .03 2.798-1.402 2.798H4.2c-1.432 0-2.402-1.798-1.402-2.798L4.8 15.3',
  'Custom Software': 'M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3',
  'SaaS Development': 'M3 3h18v18H3zM3 9h18M9 21V9',
  'Mobile Applications': 'M12 18h.01M8 21h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2z',
  'Cloud Infrastructure': 'M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z',
};
---

<section id="services" class="section-pad page-section">
  <div class="section-header-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:flex-end;margin-bottom:4rem;">
    <div class="fade-up">
      <div style="margin-bottom:1.25rem;">
        <span style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.4rem 1rem;border-radius:9999px;background:linear-gradient(135deg,rgba(34,211,238,0.12) 0%,rgba(129,140,248,0.08) 100%);border:1px solid rgba(34,211,238,0.2);font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:#22D3EE;">
          <span style="width:6px;height:6px;border-radius:50%;background:linear-gradient(135deg,#22D3EE 0%,#818CF8 100%);"></span>
          What We Build
        </span>
      </div>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,4vw,3.25rem);font-weight:600;line-height:1.12;color:#EDF0FF;letter-spacing:-0.02em;">AI-native <em class="gradient-text" style="font-style:normal;">capabilities</em></h2>
    </div>
    <div class="fade-up delay-1">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:300;color:#8892A8;line-height:1.75;max-width:400px;">Every engagement starts with AI architecture. Whether it's a mobile app, a SaaS product, or internal tooling — intelligence is built in from day one.</p>
    </div>
  </div>

  <div class="services-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;">
    {services.map((svc, i) => (
      <article class={`service-card fade-up delay-${i % 4}`}>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;color:#22D3EE;letter-spacing:0.15em;margin-bottom:2rem;">{svc.num}</div>
        <div style="margin-bottom:1.25rem;color:#22D3EE;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d={iconPaths[svc.title] || 'M12 2l9 7-9 7-9-7 9-7zM3 14l9 7 9-7'} />
          </svg>
        </div>
        <h3 style="font-family:'Space Grotesk',sans-serif;font-size:1.375rem;font-weight:600;color:#EDF0FF;margin-bottom:0.875rem;line-height:1.2;">{svc.title}</h3>
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.9rem;font-weight:300;color:#8892A8;line-height:1.7;">{svc.desc}</p>
        <a href={`/services/${svc.slug}`} class="arrow-btn" aria-label={`Learn more about ${svc.title}`}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        </a>
      </article>
    ))}
  </div>
</section>
