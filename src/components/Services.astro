---
import { services } from '../data/services.ts';

const iconPaths: Record<string, string> = {
  'AI Development': 'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 3a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm0 14.2a7.2 7.2 0 0 1-6-3.22c.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08a7.2 7.2 0 0 1-6 3.22z',
  'Custom Software Development': 'M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m8 0h3a2 2 0 0 0 2-2v-3',
  'SaaS Development': 'M3 3h18v18H3zM3 9h18M9 21V9',
  'Mobile Applications': 'M12 18h.01M8 21h8a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2z',
  'Cloud Application Development': 'M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z',
};
---

<section id="services" class="section-pad page-section">
  <div class="section-header-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:flex-end;margin-bottom:4rem;">
    <div class="fade-up">
      <div style="margin-bottom:1.25rem;">
        <span style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.4rem 1rem;border-radius:9999px;background:linear-gradient(135deg,rgba(99,102,241,0.1) 0%,rgba(139,92,246,0.08) 50%,rgba(6,182,212,0.1) 100%);border:1px solid rgba(15,23,42,0.08);font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:#4f46e5;">
          <span style="width:6px;height:6px;border-radius:50%;background:linear-gradient(135deg,#6366f1 0%,#8b5cf6 50%,#06b6d4 100%);"></span>
          Our Services
        </span>
      </div>
      <h2 style="font-family:'Space Grotesk',sans-serif;font-size:clamp(2rem,4vw,3.25rem);font-weight:600;line-height:1.12;color:#0b0f1a;letter-spacing:-0.02em;">Core <em class="gradient-text" style="font-style:normal;">disciplines</em></h2>
    </div>
    <div class="fade-up delay-1">
      <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:300;color:#5b6478;line-height:1.75;max-width:400px;">Premium design and development services built for modern brands and fast-growing startups that demand quality.</p>
    </div>
  </div>

  <div class="services-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.25rem;">
    {services.map((svc, i) => (
      <article class={`service-card fade-up delay-${i % 4}`}>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;color:#4f46e5;letter-spacing:0.15em;margin-bottom:2rem;">{svc.num}</div>
        <div style="margin-bottom:1.25rem;color:#6366f1;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d={iconPaths[svc.title] || 'M12 2l9 7-9 7-9-7 9-7zM3 14l9 7 9-7'} />
          </svg>
        </div>
        <h3 style="font-family:'Space Grotesk',sans-serif;font-size:1.375rem;font-weight:600;color:#0b0f1a;margin-bottom:0.875rem;line-height:1.2;">{svc.title}</h3>
        <p style="font-family:'Plus Jakarta Sans',sans-serif;font-size:0.9rem;font-weight:300;color:#5b6478;line-height:1.7;">{svc.desc}</p>
        <a href={`/services/${svc.slug}`} class="arrow-btn" aria-label={`Learn more about ${svc.title}`}>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        </a>
      </article>
    ))}
  </div>
</section>
