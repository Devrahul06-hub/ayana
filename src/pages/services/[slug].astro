---
import { serviceData } from '../../data/services.ts';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return Object.keys(serviceData).map(slug => ({
    params: { slug },
    props: { data: serviceData[slug] },
  }));
}

interface Props {
  data: (typeof serviceData)[string];
}

const { slug } = Astro.params;
const { data } = Astro.props;

const T = {
  bg: '#08091A',
  surface: '#0F1629',
  onAccent: '#08091A',
  accent: '#22D3EE',
  accentDark: '#0EA5C9',
  gradient: 'linear-gradient(135deg, #22D3EE 0%, #818CF8 100%)',
  gradientSoft: 'linear-gradient(135deg, rgba(34,211,238,0.08) 0%, rgba(129,140,248,0.06) 100%)',
  muted: '#8892A8',
  faint: '#505A72',
  border: 'rgba(255,255,255,0.07)',
  text: '#EDF0FF',
  shadowCard: '0 8px 32px -8px rgba(34,211,238,0.12), 0 4px 16px -4px rgba(0,0,0,0.4)',
  shadowSm: '0 2px 10px rgba(0,0,0,0.3)',
  shadowGlow: '0 12px 40px -8px rgba(34,211,238,0.4)',
  radiusPill: 9999,
  radiusLg: 20,
};
---

<Layout title={data.metaTitle} description={data.metaDescription} canonicalUrl={`https://ayanatechnologies.in/services/${slug}`}>
  <div style={`background:${T.bg};min-height:100vh;color:${T.text};`}>

    <!-- Nav bar -->
    <div style={`position:fixed;top:0;left:0;right:0;z-index:90;background:rgba(8,9,26,0.92);backdrop-filter:blur(16px);border-bottom:1px solid ${T.border};padding:1rem 3rem;display:flex;align-items:center;justify-content:space-between;`}>
      <a href="/" style={`display:inline-flex;align-items:center;gap:0.5rem;font-family:'Plus Jakarta Sans',sans-serif;font-size:0.875rem;font-weight:500;color:${T.muted};text-decoration:none;`}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Ayana Technologies
      </a>
      <a href="/#contact" style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:0.875rem;font-weight:700;padding:0.6rem 1.25rem;background:${T.gradient};color:${T.onAccent};text-decoration:none;border-radius:${T.radiusPill}px;box-shadow:0 4px 16px rgba(34,211,238,0.3);`}>
        Book a call
      </a>
    </div>

    <!-- Hero -->
    <div style="padding-top:8rem;padding-bottom:5rem;padding-left:3rem;padding-right:3rem;max-width:1280px;margin:0 auto;" class="fade-up">
      <span style={`display:inline-flex;align-items:center;gap:0.5rem;padding:0.4rem 1rem;border-radius:${T.radiusPill}px;background:${T.gradientSoft};border:1px solid rgba(34,211,238,0.2);font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:${T.accentDark};margin-bottom:1.5rem;display:inline-flex;`}>
        <span style={`width:6px;height:6px;border-radius:50%;background:${T.gradient};`}></span>
        Service
      </span>
      <h1 style={`font-family:'Space Grotesk',sans-serif;font-size:clamp(2.5rem,5vw,4.5rem);font-weight:700;line-height:1.05;letter-spacing:-0.03em;color:${T.text};margin-bottom:1.25rem;`}>{data.title}</h1>
      <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:1.25rem;font-weight:400;color:${T.muted};line-height:1.6;max-width:600px;margin-bottom:2rem;`}>{data.tagline}</p>
      <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:300;color:${T.muted};line-height:1.8;max-width:680px;`}>{data.description}</p>
    </div>

    <!-- Deliverables -->
    <div style={`padding:4rem 3rem;max-width:1280px;margin:0 auto;border-top:1px solid ${T.border};`}>
      <h2 style={`font-family:'Space Grotesk',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:600;color:${T.text};margin-bottom:2.5rem;letter-spacing:-0.02em;`} class="fade-up">What&apos;s included</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:1rem;" class="fade-up delay-1">
        {data.deliverables.map(item => (
          <div style={`display:flex;align-items:flex-start;gap:0.75rem;padding:1.25rem 1.5rem;background:${T.surface};border:1px solid ${T.border};border-radius:${T.radiusLg}px;box-shadow:${T.shadowSm};`}>
            <div style={`flex-shrink:0;width:22px;height:22px;background:${T.gradient};border-radius:50%;display:flex;align-items:center;justify-content:center;margin-top:1px;`}>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="#08091A" stroke-width="2.5" stroke-linecap="round"><polyline points="2,6 5,9 10,3"/></svg>
            </div>
            <span style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:0.9rem;font-weight:500;color:${T.text};line-height:1.5;`}>{item}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Use Cases -->
    <div style={`padding:4rem 3rem;max-width:1280px;margin:0 auto;border-top:1px solid ${T.border};background:${T.gradientSoft};`}>
      <h2 style={`font-family:'Space Grotesk',sans-serif;font-size:clamp(1.5rem,3vw,2.25rem);font-weight:600;color:${T.text};margin-bottom:2.5rem;letter-spacing:-0.02em;`} class="fade-up">Common use cases</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.25rem;">
        {data.useCases.map((uc, i) => (
          <div class={`fade-up delay-${i + 1}`} style={`padding:2rem;background:${T.surface};border:1px solid ${T.border};border-radius:${T.radiusLg}px;box-shadow:${T.shadowCard};`}>
            <h3 style={`font-family:'Space Grotesk',sans-serif;font-size:1.125rem;font-weight:600;color:${T.text};margin-bottom:0.625rem;`}>{uc.title}</h3>
            <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:0.9rem;font-weight:300;color:${T.muted};line-height:1.7;`}>{uc.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div style={`padding:5rem 3rem;max-width:1280px;margin:0 auto;border-top:1px solid ${T.border};text-align:center;`} class="fade-up">
      <h2 style={`font-family:'Space Grotesk',sans-serif;font-size:clamp(1.75rem,3.5vw,2.75rem);font-weight:600;color:${T.text};margin-bottom:1rem;letter-spacing:-0.02em;`}>Have a project in mind?</h2>
      <p style={`font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;color:${T.muted};margin-bottom:2rem;`}>Tell us what you're building. We'll tell you honestly whether and how we can help — for free.</p>
      <a href="/#contact" style={`display:inline-flex;align-items:center;gap:0.75rem;padding:1rem 2.25rem;background:${T.gradient};color:${T.onAccent};font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:700;border-radius:${T.radiusPill}px;text-decoration:none;box-shadow:${T.shadowGlow};`}>
        Book a free AI call
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M3 9h12M11 5l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
    </div>

    <!-- Footer -->
    <div style={`border-top:1px solid ${T.border};padding:1.5rem 3rem;max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;`}>
      <span style={`font-family:'Space Grotesk',sans-serif;font-size:0.9rem;font-weight:600;color:${T.muted};`}>Ayana<span style="background:linear-gradient(135deg,#22D3EE 0%,#818CF8 100%);-webkit-background-clip:text;background-clip:text;color:transparent;font-style:italic;"> Technologies LLP</span></span>
      <span style={`font-family:'IBM Plex Mono',monospace;font-size:0.6875rem;color:${T.faint};`}>© 2025 Ayana Technologies LLP. All rights reserved.</span>
    </div>
  </div>
</Layout>

<style is:global>
  @import '../../styles/global.css';
</style>
